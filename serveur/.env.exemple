# ─────────────────────────────────────────────────────────────────────────────
#  Copiez ce fichier en « .env » (même dossier) puis remplissez ce que vous avez.
#  Ce fichier reste sur VOTRE ordinateur : ne l'envoyez à personne, ne le mettez pas sur GitHub.
#  Une ligne vide = le canal est désactivé (l'application l'indique dans Profil > Notifications).
# ─────────────────────────────────────────────────────────────────────────────

# Telegram (gratuit) : jeton donné par @BotFather, et nom du bot SANS le @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMS Orange (après approbation d'Orange) : fiche de l'application sur developer.orange.com
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=tel:+2210000

# WhatsApp (mode test de Meta) : jeton d'accès + Phone number ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Codes par e-mail (Gmail : « mot de passe d'application », pas votre mot de passe habituel)
MAIL_USER=
MAIL_PASS=

# Dons : liens de paiement marchand (facultatif)
WAVE_LIEN_PAIEMENT=
ORANGE_MONEY_LIEN_PAIEMENT=

# Groupes d'entraide (liens d'invitation que VOUS créez dans Telegram et WhatsApp)
#   Telegram : nouveau groupe > Inviter via un lien > copier le lien  (https://t.me/+...)
#   WhatsApp : groupe > Inviter via un lien > copier le lien          (https://chat.whatsapp.com/...)
COMMUNAUTE_TELEGRAM_URL=
COMMUNAUTE_WHATSAPP_URL=

# Visio en ligne : relais TURN (laisser vide sur le PC / Wi-Fi local)
TURN_URL=
TURN_SECRET=

# Mettre true quand vous lancez le tunnel HTTPS public (docker compose --profile public up -d)
TRUST_PROXY=false
