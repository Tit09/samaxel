# ═══════════════════════════════════════════════════════════════════════════
#  SAMA XHEL Santé — configuration (copier vers .env et compléter)
#  ⚠ Ne JAMAIS envoyer le fichier .env (ni le zipper, ni le pousser sur GitHub)
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3001
# true si l'API est derrière Nginx (pour connaître la vraie IP des clients)
TRUST_PROXY=false
# Domaines autorisés à appeler l'API depuis un navigateur (site vitrine, app web)
CORS_ORIGINS=https://samaxhel.sn,https://www.samaxhel.sn

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=samaxhel
DB_SSL=false
# Compte propriétaire : utilisé UNIQUEMENT par « npm run migrate » et « npm run seed »
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_fort
# Rôle applicatif (créé automatiquement par la migration) : soumis à la RLS
APP_DB_USER=samaxhel_app
APP_DB_PASSWORD=remplacer_par_un_autre_mot_de_passe_fort

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Chiffrement des données de santé (64 caractères hexadécimaux chacune) ──
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ Perdre DATA_ENCRYPTION_KEY = perdre toutes les données chiffrées. Sauvegardez-la à part.
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=

# ── Jetons de connexion (clés générées par « npm run keys ») ───────────────
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_JOURS=30

# ── Argon2id (hachage des mots de passe) ───────────────────────────────────
ARGON2_MEMORY=19456
ARGON2_TIME=2
ARGON2_PARALLELISM=1

# ── Développement : affiche les codes OTP dans la console au lieu de les envoyer
OTP_CONSOLE=true

# ── SMS réels : API Orange SMS Sénégal (developer.orange.com) ──────────────
# Sur le serveur, ces valeurs sont saisies par « node scripts/configurer-serveur.js »
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=tel:+2210000
ORANGE_SMS_SENDER_NAME=SAMA XHEL
# ── Telegram (gratuit) : créer le bot avec @BotFather ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Groupe d'astreinte qui reçoit les alertes de sécurité en temps réel (identifiant numérique, ex. -1001234567890)
TELEGRAM_ALERTES_CHAT_ID=
# polling sur un PC ; webhook sur le serveur en ligne (+ TELEGRAM_WEBHOOK_SECRET)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# ── WhatsApp (API Cloud de Meta, developers.facebook.com) ──────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_HAS_TEXT=false
# ── SMS (Africa's Talking, ancien fournisseur, bac à sable seulement) ──────
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ── E-mail (SMTP) ──────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=SAMA XHEL <no-reply@samaxhel.sn>

# ── Téléconsultation WebRTC : relais TURN (coturn) sur le serveur en ligne ──
# Sur le réseau local (PC + téléphone sur le même Wi-Fi), laisser vide : la connexion est directe.
TURN_URL=
TURN_SECRET=

# ── Notifications push (contenu JSON du compte de service Firebase) ────────
FCM_SERVICE_ACCOUNT_JSON=

# ── Dons ───────────────────────────────────────────────────────────────────
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_LIEN_PAIEMENT=
DON_SUCCESS_URL=https://samaxhel.sn/#don
DON_ERROR_URL=https://samaxhel.sn/#don
